[Unit]
Description=Prometheus 2.0 pipeline crawl (oneshot; trigger manually or via timer if enabled)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/prometheus-20
ExecStart=/usr/bin/bash /opt/prometheus-20/infra/run_crawl_stage.sh

[Install]
WantedBy=multi-user.target
