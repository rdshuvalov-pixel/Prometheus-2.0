[Unit]
Description=Prometheus pipeline timer (automatic runs disabled in repo)

[Timer]
# Автозапуск пайплайна отключён по умолчанию (LLM/краулер тратят деньги в фоне).
# Реальное расписание добавляйте здесь вручную после проверки, например:
#   OnCalendar=*-*-* 11:30:00 UTC
#   RandomizedDelaySec=2min
#   Persistent=true
#
# Заглушка до 2099 г.: юнит остаётся валидным для systemd, но не будет запусков десятилетиями.
OnCalendar=2099-01-01 00:00:00 UTC

[Install]
WantedBy=timers.target
