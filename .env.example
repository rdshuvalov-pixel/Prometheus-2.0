OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Один проект: SUPABASE_URL = то же, что NEXT_PUBLIC_SUPABASE_URL на Vercel (см. docs/E2E_VERIFICATION.md)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend (Python): service_role из Supabase → Settings → API
SUPABASE_SERVICE_KEY=
# Frontend (Next/Vercel): то же значение service_role
SUPABASE_SERVICE_ROLE_KEY=
# Прямое подключение к Postgres для CLI-миграций (Database → Connection string → URI)
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
PIPELINE_API_SECRET=
# Для Next.js Preview весов (прокси на FastAPI)
PROMETHEUS_API_URL=http://127.0.0.1:8080
# Опционально Tier 4: доп. сайты JobSpy через запятую
JOBSPY_SITES=
